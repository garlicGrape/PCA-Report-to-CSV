# Copy this file to `.env` and fill in your real keys:  cp .env.example .env
# Never commit .env — it's in .gitignore.

# Anthropic API (the AWS-free extraction path). From console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# LangSmith tracing + evals. Key from smith.langchain.com -> Settings -> API Keys
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
# This MUST match the project/application name in the LangSmith UI exactly.
LANGSMITH_PROJECT=pca-extract
